// Правила доступа к базе. Скопировать в Firebase → Firestore Database → Rules → Publish.
//
// Без них база по умолчанию либо закрыта совсем, либо (в тестовом режиме) открыта всем,
// кто знает адрес приложения. Список почт здесь — единственное, что реально закрывает
// данные: ключи в config.js публичны и ничего не защищают.
//
// Тот же список должен стоять в web/config.js (FINANCE_ALLOWED_EMAILS) — там он нужен,
// чтобы чужой аккаунт увидел понятное «нет доступа», а не ошибку базы.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'anuarbekyt@gmail.com'
           ];
    }

    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
