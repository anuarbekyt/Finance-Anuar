// Правила доступа к базе. Публикуются командой `npm run deploy`.
//
// Правила — единственное, что закрывает данные: ключи в config.js публичны и ничего
// не защищают.
//
// Войти может любой аккаунт Google, но данные у каждого свои. Владелец работает
// с корневыми коллекциями, любой другой — только со своим spaces/<почта>/…. Друг друга
// они не видят: владельцу закрыта папка spaces, остальным — всё, кроме своей папки.
// Почта владельца стоит и в web/config.js (FINANCE_OWNER_EMAIL) — менять в обоих местах.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && me() == 'anuarbekyt@gmail.com';
    }

    match /spaces/{email}/{document=**} {
      allow read, write: if signedIn() && me() == email;
    }

    match /{coll}/{document=**} {
      allow read, write: if isOwner() && coll != 'spaces';
    }
  }
}
